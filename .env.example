DATABASE_URL=postgresql+psycopg://postgres:[database Password]@localhost:5432/attendance_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.3:5173

# Supabase Storage (backend only; never expose service-role key to React)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_ENABLED=true
SUPABASE_ATTENDANCE_BUCKET=attendance-photos
SUPABASE_FACE_BUCKET=face-images

# SMTP - use your college/organization SMTP or Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=AttendAI
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60

# Face recognition
FACE_MODEL=cnn
FACE_TOLERANCE=0.50
